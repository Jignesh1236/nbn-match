# Optional: endpoint that receives registration submissions as JSON (HTTP POST).
# e.g. a Formspree/Basin form URL or your own API route.
# Leave unset and the form will show a "registration not yet open" notice.
# VITE_REGISTRATION_ENDPOINT=https://your-api.example.com/api/registrations

# Supabase (only the anon key is used in the frontend — never the service_role key)
VITE_SUPABASE_URL=https://tiidlomvpakogmrfedan.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Edge Functions CORS allow-list. This is a SUPABASE SECRET, not a
# Vite variable: set it with `supabase secrets set ALLOWED_ORIGIN=...` and
# redeploy the functions. Comma-separated, exact origins (scheme + host + port).
# ALLOWED_ORIGIN=https://your-site.example.com,http://localhost:5173

# Non-obvious admin path, e.g. /nbn-admin-7x9m2. Admin UI lives under this route.
VITE_ADMIN_PATH=/nbn-admin-7x9m2

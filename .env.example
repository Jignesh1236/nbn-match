# Optional: endpoint that receives registration submissions as JSON (HTTP POST).
# e.g. a Formspree/Basin form URL or your own API route.
# Leave unset and the form will show a "registration not yet open" notice.
# VITE_REGISTRATION_ENDPOINT=https://your-api.example.com/api/registrations

# Supabase (only the anon key is used in the frontend — never the service_role key)
VITE_SUPABASE_URL=https://tiidlomvpakogmrfedan.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Edge Functions CORS. By default the functions reflect the caller's
# Origin, so a candidate link works from any device (localhost, LAN IP, preview
# URL, custom domain) without extra configuration. Redeploy the functions
# after changing anything in supabase/functions.
#
# Optional strict mode (SUPABASE SECRETS, not Vite variables): set
# CORS_STRICT_ALLOWLIST=true and list exact origins (scheme + host + port) in
# ALLOWED_ORIGIN, then redeploy:
#   npx supabase secrets set CORS_STRICT_ALLOWLIST=true \
#     ALLOWED_ORIGIN=https://your-site.example.com,http://localhost:5173 \
#     --project-ref <project-ref>
#   npx supabase functions deploy --project-ref <project-ref>
# ALLOWED_ORIGIN=https://your-site.example.com,http://localhost:5173

# Non-obvious admin path, e.g. /nbn-admin-7x9m2. Admin UI lives under this route.
VITE_ADMIN_PATH=/nbn-admin-7x9m2
